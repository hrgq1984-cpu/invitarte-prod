rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Plans and Templates
    match /plans/{planId} {
      allow read, write: if true;
    }

    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Projects (Invitations and Orders)
    match /projects/{projectId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Event Settings
    match /event_settings/{settingId} {
      allow read, write: if true;
    }

    // Guests, Blessings, Photos, Display Settings
    match /guests/{guestId} {
      allow read, write: if true;
    }

    match /blessings/{blessingId} {
      allow read, write: if true;
    }

    match /photos/{photoId} {
      allow read, write: if true;
    }

    match /display_settings/{displayId} {
      allow read, write: if true;
    }

    // Payments / Bank transfer receipts
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Admin Notifications
    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // User profiles & system
    match /users/{userId} {
      allow read, write: if true;
    }

    match /system/{systemId} {
      allow read, write: if true;
    }
  }
}


