rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAnonymousOrder() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function ownsProject(projectId) {
      return signedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.clientEmail == request.auth.token.email
      );
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if ownsProject(projectId);
      allow create: if isAdmin() ||
        (isAnonymousOrder() && request.resource.data.status in ['payment_review', 'preview_available']);
      allow update: if ownsProject(projectId);
      allow delete: if isAdmin();
    }

    match /event_settings/{projectId} {
      allow read: if ownsProject(projectId);
      allow create: if isAnonymousOrder() && request.resource.data.projectId == projectId;
      allow update: if ownsProject(projectId);
    }

    match /guests/{guestId} {
      allow read, write: if ownsProject(resource.data.projectId);
      allow create: if ownsProject(request.resource.data.projectId);
      allow delete: if ownsProject(resource.data.projectId);
    }

    match /blessings/{blessingId} {
      allow read, create: if signedIn();
      allow update, delete: if ownsProject(resource.data.projectId);
    }

    match /photos/{photoId} {
      allow read, create: if signedIn();
      allow update, delete: if ownsProject(resource.data.projectId);
    }

    match /display_settings/{projectId} {
      allow read, write: if ownsProject(projectId);
    }

    match /payments/{paymentId} {
      allow read: if ownsProject(resource.data.projectId);
      allow create: if isAdmin() || (isAnonymousOrder() &&
        get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.status in ['payment_review', 'preview_available']);
      allow update: if isAdmin() || ownsProject(resource.data.projectId);
      allow delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (isAnonymousOrder() &&
        request.resource.data.type in ['order_created', 'receipt_uploaded']);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if signedIn() && (isAdmin() || request.auth.uid == userId);
    }

    match /system/{systemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}


